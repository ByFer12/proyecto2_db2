# Copiar a .env y ajustar:  cp .env.example .env

# ---------- MongoDB ----------
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=pruebas_especificas
MONGO_PORT=27017
# URI usada por el backend (dentro de Docker el host es "mongo"; fuera de Docker usar localhost)
MONGO_URI=mongodb://admin:admin123@localhost:27017/?authSource=admin

# ---------- Neo4j ----------
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j12345
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# URI usada por el backend (dentro de Docker el host es "neo4j")
NEO4J_URI=bolt://localhost:7687

# ---------- Backend ----------
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
ETL_CHUNK_SIZE=5000

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

